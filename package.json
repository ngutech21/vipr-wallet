{
  "name": "vipr",
  "version": "0.3.0",
  "description": "Fedimint eCash Wallet",
  "productName": "Vipr Wallet",
  "author": "ngutech21 <ngutech21@pm.me>",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"{src,test}/**/*.{ts,js,cjs,mjs,vue}\" --max-warnings 0",
    "lint:fix": "eslint -c ./eslint.config.js \"{src,test}/**/*.{ts,js,cjs,mjs,vue}\" --fix --max-warnings 0",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\"",
    "format:check": "prettier --check \"**/*.{js,ts,vue,scss,html,md,json}\"",
    "test": "pnpm run test:unit:ci",
    "dev": "BROWSER=none  quasar dev -m pwa",
    "dev:e2e": "unset HTTPS_KEY HTTPS_CERT; VITE_E2E_MODE=1 BROWSER=none quasar dev -m pwa --port 9303",
    "build": "quasar build -m pwa",
    "build:docker": "docker build -t vipr-wallet .",
    "postinstall": "quasar prepare && pnpm --dir src-pwa install --frozen-lockfile --strict-peer-dependencies",
    "coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage",
    "test:setup": "bash scripts/setup_test_shell.sh",
    "test:shell": "bash scripts/setup_test_shell.sh bash",
    "test:unit:ui": "NODE_OPTIONS=--no-experimental-webstorage vitest --ui",
    "test:unit:ci": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:e2e": "pnpm run test:setup -- playwright test",
    "test:e2e:headed": "playwright test --headed",
    "typecheck": "exec vue-tsc --noEmit",
    "typecheck:pwa": "exec tsc -p src-pwa/sw/tsconfig.json --noEmit",
    "audit:pwa": "pnpm --dir src-pwa audit --prod && pnpm --dir src-pwa audit signatures",
    "check:circular": "madge src --extensions ts --ts-config tsconfig.madge.json --circular",
    "final-check": "pnpm format:check && pnpm lint && pnpm peers check && pnpm typecheck && pnpm typecheck:pwa && pnpm audit --prod && pnpm audit signatures && pnpm audit:pwa && pnpm check:circular && pnpm build && pnpm test:unit:ci"
  },
  "dependencies": {
    "@fedimint/core": "0.0.0-canary-bdba63f3b69629f2b7bff73cf25589bd16332838",
    "@fedimint/transport-web": "0.0.0-canary-bdba63f3b69629f2b7bff73cf25589bd16332838",
    "@getalby/bitcoin-connect": "^3.12.3",
    "@getalby/lightning-tools": "^9.0.1",
    "@nostr-dev-kit/ndk": "^3.0.3",
    "@quasar/extras": "^2.0.4",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^14.4.0",
    "bech32": "^2.0.0",
    "consola": "^3.4.2",
    "js-confetti": "^0.13.1",
    "qrcode.vue": "^3.10.0",
    "qrloop": "^1.4.1",
    "quasar": "^2.24.0",
    "uuid": "^14.0.2",
    "vue": "^3.5.41",
    "vue-qrcode-reader": "^5.7.3",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@pinia/testing": "^2.0.1",
    "@playwright/test": "1.61.1",
    "@quasar/app-vite": "^3.6.1",
    "@quasar/cli": "^5.0.7",
    "@quasar/vite-plugin": "^2.0.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "madge": "^8.0.0",
    "pinia": "^4.0.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.10"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
